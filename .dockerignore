.git
.github
.gitignore

# Jangan pernah masukkan file environment lokal ke image
.env
.env.*
!.env.example

node_modules
vendor

# Hasil build lokal, dibangun ulang di dalam image
public/build
public/hot
public/storage

# File runtime: buang isinya, tapi pertahankan folder + .gitignore
# agar Laravel bisa menemukan storage/framework/views saat view:cache.
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
bootstrap/cache/*.php
database/*.sqlite

# Berkas pengembangan
.phpunit.cache
.phpunit.result.cache
.phpactor.json
/auth.json
tests
Dockerfile*
.dockerignore
render.yaml
DEPLOY.md
README.md
